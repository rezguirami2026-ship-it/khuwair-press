{
  "name": "khuwair-press",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site && npm run build:single && npm run build:gallery",
    "build:site": "vite build --mode site",
    "build:single": "vite build --mode single && node scripts/after-single.mjs",
    "preview": "vite preview --outDir dist/site",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "build:gallery": "vite build --mode gallery"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/el-messiri": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@fontsource/rakkas": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "fflate": "^0.8.3",
    "jspdf": "2.5.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
